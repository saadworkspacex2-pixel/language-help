# ---------------------------------------------------------------------------
# Language Help BD — environment
# Copy to .env.local (local dev) or set these in your host's dashboard.
# ---------------------------------------------------------------------------

# Database (Postgres) — required
DATABASE_URL=postgresql://user:password@host:5432/lhbd

# ---------------------------------------------------------------------------
# Google sign-in (OAuth 2.0 / OpenID Connect)
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
# Leave blank to hide the "Continue with Google" button.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — set only if your public URL differs from the request origin
# GOOGLE_REDIRECT_URI=https://languagehelpbd.com/api/auth/google/callback

# ---------------------------------------------------------------------------
# Email / OTP delivery (nodemailer SMTP)
# Gmail: use an App Password (2FA on). Port 465 (SSL) or 587 (STARTTLS).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Language Help BD <no-reply@languagehelpbd.com>"

# Secret used to hash stored OTP codes (any long random string)
OTP_SECRET=change-me-to-a-long-random-string
# Set to 1 ONLY on staging to show the code in the UI when SMTP is missing
OTP_DEV_MODE=0
